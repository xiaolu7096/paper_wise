{
  "name": "paperwise-frontend",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "npm run typecheck && vite build --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run --configLoader runner --no-cache",
    "test:e2e": "playwright test --pass-with-no-tests",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
