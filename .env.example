# Server
PAPERWISE_HOST=127.0.0.1
PAPERWISE_PORT=8000
PAPERWISE_FRONTEND_ORIGIN=http://127.0.0.1:5173
PAPERWISE_DATA_DIR=./data
PAPERWISE_JOBS_ENABLED=true
PAPERWISE_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# Optional Hugging Face endpoint. On networks that cannot reach huggingface.co,
# use https://hf-mirror.com. Downloaded models are persisted by Docker Compose.
HF_ENDPOINT=

# OPT-005 public deployment
# Local development keeps auth disabled. Public deployment must enable auth.
PAPERWISE_AUTH_ENABLED=false
PAPERWISE_SESSION_COOKIE_SECURE=false
PAPERWISE_SESSION_DAYS=14
PAPERWISE_KEY_ENCRYPTION_KEY=
PAPERWISE_PUBLIC_HOST=

# Caddy address. Use ":80" for an IP-only dry run, or your domain for HTTPS.
PAPERWISE_SITE_ADDRESS=:80

# Text model (OpenAI-compatible Chat Completions)
PAPERWISE_TEXT_MODEL_BASE_URL=
PAPERWISE_TEXT_MODEL_NAME=
PAPERWISE_TEXT_MODEL_API_KEY=

# Vision model (OpenAI-compatible Chat Completions)
PAPERWISE_VISION_MODEL_BASE_URL=
PAPERWISE_VISION_MODEL_NAME=
PAPERWISE_VISION_MODEL_API_KEY=
